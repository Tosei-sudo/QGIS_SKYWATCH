{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIKAGE 参考情報の取り込みファイル",
  "description": "ドック「参考情報」の「JSON 取り込み…」で読む JSON ファイルの形（版 1）。1 件の参考情報が infos の 1 要素。id があれば同じ ID の参考情報を更新し（書いたキーだけ変える。\"\" か null で消す）、なければその ID で追加する。id を省くと REF-… の ID を付けて追加する。文字数の上限は既定のテーブル定義（TBL_REFERENCE_INFO・TBL_REFERENCE_LINK）の長さ。プラグインはこのファイルで検証する。",
  "type": "object",
  "required": ["infos"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "このスキーマの場所（エディターの補完用。プラグインは読まない）"
    },
    "format": {
      "const": "mikage-reference-info",
      "description": "ファイルの種類（省略可）"
    },
    "version": {
      "const": 1,
      "description": "形の版（省略可。いまは 1）"
    },
    "defaults": {
      "type": "object",
      "description": "infos の各要素に書いていないキーに入れる値（同じ出典の情報をまとめて入れるとき）。id・title・time・lon・lat・links は書けない",
      "additionalProperties": false,
      "properties": {
        "published": { "$ref": "#/$defs/timeOrNull" },
        "source": { "$ref": "#/$defs/source" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "reliability": { "$ref": "#/$defs/reliability" },
        "summary": { "$ref": "#/$defs/summary" },
        "kind": { "$ref": "#/$defs/kind" },
        "area": { "$ref": "#/$defs/area" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "infos": {
      "type": "array",
      "description": "参考情報（1 ファイル 10,000 件まで）",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/info" }
    }
  },
  "$defs": {
    "info": {
      "type": "object",
      "description": "参考情報 1 件",
      "required": ["title", "time"],
      "additionalProperties": false,
      "dependentRequired": { "lon": ["lat"], "lat": ["lon"] },
      "properties": {
        "id": {
          "type": "string",
          "description": "情報ID。同じ ID があれば更新、なければこの ID で追加。省くと REF-20261124-103000-1a2b の形の ID を付ける",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(.*\\S)?$",
          "examples": ["NAV-2026-0123"]
        },
        "title": {
          "type": "string",
          "description": "題名",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S",
          "examples": ["〇〇沖で射撃訓練（航行警報）"]
        },
        "time": {
          "$ref": "#/$defs/time",
          "description": "出来事の日時（発表の日時ではなく、起きた・見られた日時）"
        },
        "published": { "$ref": "#/$defs/timeOrNull" },
        "source": { "$ref": "#/$defs/source" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "reliability": { "$ref": "#/$defs/reliability" },
        "summary": { "$ref": "#/$defs/summary" },
        "kind": { "$ref": "#/$defs/kind" },
        "area": { "$ref": "#/$defs/area" },
        "lon": {
          "type": ["number", "null"],
          "description": "地点の経度（WGS 84、度）。lat と一緒に書く。null で地点を消す",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": ["number", "null"],
          "description": "地点の緯度（WGS 84、度）。lon と一緒に書く。null で地点を消す",
          "minimum": -90,
          "maximum": 90
        },
        "note": { "$ref": "#/$defs/note" },
        "links": {
          "type": "array",
          "description": "紐付け（足すだけ。外すことはしない。同じ組は 1 つのまま）",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "link": {
      "type": "object",
      "description": "紐付ける項目 1 つ",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["event", "thing", "observation"],
          "description": "event（イベント）・thing（モノ。観測記録の OBJECT_ID）・observation（観測記録）"
        },
        "id": {
          "type": "string",
          "description": "イベント ID・モノ ID・記録 ID",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "description": "一覧に出す名前（省くと ID を出す）",
          "maxLength": 255
        }
      }
    },
    "time": {
      "type": "string",
      "description": "日時。ISO 8601: 2026-11-24、2026-11-24T10:30、2026-11-24T10:30:00+09:00、2026-11-24T01:30:00Z。タイムゾーンのないものは PC の時刻",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$",
      "examples": ["2026-11-24T10:30:00+09:00"]
    },
    "timeOrNull": {
      "description": "発表日時（発表・入手の日時。形は time と同じ。null で消す）",
      "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }]
    },
    "source": {
      "type": ["string", "null"],
      "description": "出典（発表した組織・媒体）",
      "maxLength": 255,
      "examples": ["海上保安庁"]
    },
    "sourceRef": {
      "type": ["string", "null"],
      "description": "文書番号か URL（URL ならドックから開ける）",
      "maxLength": 1000,
      "examples": ["航行警報 第123号", "https://news.example/article/123"]
    },
    "reliability": {
      "type": ["string", "null"],
      "description": "確からしさ（観測記録の確度と同じ言葉。既定は 確定・推定・不明）",
      "maxLength": 64,
      "examples": ["確定"]
    },
    "summary": {
      "type": ["string", "null"],
      "description": "要旨",
      "maxLength": 4000
    },
    "kind": {
      "type": ["string", "null"],
      "description": "分類体系の種別（大分類から > でつなぐ）",
      "maxLength": 1000,
      "examples": ["船舶 > 支援船"]
    },
    "area": {
      "type": ["string", "null"],
      "description": "何についての情報か: 地名の管理番号（NAMED_AREA_ID）か、地名の名前・別名。lon・lat がなければ、その地名の中の点が地点になる",
      "maxLength": 255,
      "examples": ["NA-000012", "横須賀港"]
    },
    "note": {
      "type": ["string", "null"],
      "description": "メモ",
      "maxLength": 2000
    }
  }
}
